-- 1. KHỞI TẠO AN TOÀN & CHỐNG CRASH
-- ===================================================================
if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Đợi nhân vật và túi đồ
repeat task.wait(0.5) until LocalPlayer.Character and LocalPlayer:FindFirstChild("Backpack")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ClientGlobals

-- Load dữ liệu game an toàn
repeat 
    local success, result = pcall(function() 
        return require(ReplicatedStorage.Client.Modules.ClientGlobals) 
    end)
    if success and result and result.Plots and result.Plots.Data then
        ClientGlobals = result
    end
    task.wait(0.5)
until ClientGlobals

local EconomyMath = require(ReplicatedStorage.Shared.utils.EconomyMath)

-- ===================================================================
-- 2. THIẾT LẬP REMOTE CHUẨN
-- ===================================================================
local Net = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net")

local PlotActionRF = Net:WaitForChild("RF/Plot.PlotAction")
local SendTradeRF = Net:WaitForChild("RF/Trade.SendTrade")       -- Remote gửi yêu cầu
local SetSlotOfferRF = Net:WaitForChild("RF/Trade.SetSlotOffer") -- Remote add pet (UUID)
local RebirthRF = ReplicatedStorage:WaitForChild("RemoteFunctions"):WaitForChild("Rebirth")
local UpgradeSpeedRF = ReplicatedStorage:WaitForChild("RemoteFunctions"):WaitForChild("UpgradeSpeed")

-- VARIABLES
local AutoRebirthEnabled = true -- ON SẴN

-- UTILS
local function getMyPlotId()
    if not ClientGlobals or not ClientGlobals.Plots.Data then return nil end
    for id, data in pairs(ClientGlobals.Plots.Data) do
        if data.player == LocalPlayer then return id end
    end
    return nil
end

