local function createBtn(text, color, parent, func)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    Instance.new("UICorner", btn)
    if func then btn.MouseButton1Click:Connect(func) end
    return btn
end

-- --- BUTTON ACTIONS ---

-- 1. TRADE ADD (FIXED 6/6)
createBtn("TRADE: ADD 6 PETS", Color3.fromRGB(241, 196, 15), LeftPanel, function()
    local backpack = LocalPlayer.Backpack:GetChildren()
    local tools = {}
    -- Lọc lấy Tool trước
    for _, v in ipairs(backpack) do
        if v:IsA("Tool") then table.insert(tools, v) end
    end

    -- Loop chính xác 6 lần
    for i = 1, 6 do
        if tools[i] then
            local item = tools[i]
            -- Lấy UUID chuẩn (thử nhiều cách để không bị nil)
            local uuid = item:GetAttribute("UUID") or item:GetAttribute("UniqueId") or item:GetAttribute("uuid") or item.Name
            
            task.spawn(function()
                SetSlotOfferRF:InvokeServer(tostring(i), uuid)
            end)
            -- Tăng delay lên 0.25 để server kịp nhận xử lý con thứ 6
            task.wait(0.25)
        end
    end
end)

-- 2. PLOT: PLACE ALL (FIXED "K WORK")
createBtn("PLOT: PLACE ALL (FORCE)", Color3.fromRGB(52, 152, 219), LeftPanel, function()
    local plotId = getMyPlotId()
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not plotId or not hum then return end

    local backpack = LocalPlayer.Backpack:GetChildren()
    local pets = {}
    for _, v in ipairs(backpack) do 
        if v:IsA("Tool") then table.insert(pets, v) end 
    end

    -- Chế độ Force Place: Cứ có pet là đặt vào slot tương ứng, không cần check trống
    for i = 1, 12 do
        if pets[i] then
            hum:EquipTool(pets[i])
            task.wait(0.2) -- Bắt buộc phải wait để Equip server nhận diện
            PlotActionRF:InvokeServer("Place Brainrot", plotId, tostring(i), pets[i].Name)
            task.wait(0.1)
        else
            break -- Hết pet thì dừng
        end
    end
    hum:UnequipTools()
end)

