-- AUTO COLLECT (1 GIÂY/LẦN)
task.spawn(function()
    while true do
        local plotId = getMyPlotId()
        if plotId then
            for i = 1, 12 do
                task.spawn(function() 
                    PlotActionRF:InvokeServer("Collect Money", plotId, tostring(i)) 
                end)
            end
        end
        task.wait(1)
    end
end)

-- AUTO REBIRTH (FIXED NIL ERROR)
task.spawn(function()
    while true do
        if AutoRebirthEnabled then
            -- Dùng pcall để chặn lỗi crash script
            pcall(function()
                local currentR = LocalPlayer:GetAttribute("Rebirth") or 0
                local myS = LocalPlayer:GetAttribute("CurrentSpeed") or 0
                
                -- Tính toán Speed yêu cầu
                local reqS = EconomyMath.GetRebirthRequiredSpeed(currentR + 1)
                
                -- FIX QUAN TRỌNG: Chỉ chạy nếu reqS là số (không phải nil)
                if type(reqS) == "number" then
                    if myS < reqS then
                        -- Spam 5 request để tăng tốc
                        for k=1, 5 do 
                            task.spawn(function() UpgradeSpeedRF:InvokeServer(10) end) 
                        end
                    else
                        RebirthRF:InvokeServer()
                    end
                end
            end)
        end
        task.wait(0.15)
    end
end)

